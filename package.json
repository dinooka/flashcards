  "main": "index.js",
  "scripts": {
    "codegen": "npx playwright codegen",
    "paice": "npx playwright test --headed",
    "debug": "npx playwright test paice-login.spec.ts --debug",
    "ui-debug": "npx playwright test --ui",
    "report": "npx playwright show-report",
